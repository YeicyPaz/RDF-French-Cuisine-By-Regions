  <ns0:Plat rdf:about="http://www.gastronomie.fr/ontology#Aligot">
    <schema:name>Aligot</schema:name>
    <ns0:estOriginaireDe rdf:resource="http://www.gastronomie.fr/ontology#Occitanie"/>
    <ns0:aPourRecette>
      <ns0:Recette rdf:about="http://www.gastronomie.fr/ontology#RecetteAligot">
        <ns0:aMethodeDePreparation>Purée de pommes de terre à laquelle sont mélangés de la crème, du beurre et de la tome de Laguiole. On ajoute un peu d'ail pilé o haché finement</ns0:aMethodeDePreparation>
