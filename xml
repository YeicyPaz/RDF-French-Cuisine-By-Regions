  <rdf:Description rdf:about="http://www.gastronomie.fr/ontology#GaletteBretonne">
    <rdf:type rdf:resource="http://www.gastronomie.fr/ontology#Plat"/>
    <schema:name>Galette Bretonne</schema:name>
    <ns0:estOriginaireDe rdf:resource="http://www.gastronomie.fr/ontology#Bretagne"/>
    <ns0:aPourRecette>
      <ns0:Recette rdf:about="http://www.gastronomie.fr/ontology#RecetteGaletteBretonne">
        <ns0:aTempsDePreparation rdf:datatype="http://www.w3.org/2001/XMLSchema#duration">PT30M</ns0:aTempsDePreparation>
        <ns0:aDifficulte>facile</ns0:aDifficulte>
        <ns0:sePrepareAvec>farine de sarrasin</ns0:sePrepareAvec>
      </ns0:Recette>
    </ns0:aPourRecette>

    <ns0:aTypeDeRegime rdf:resource="http://www.gastronomie.fr/ontology#Normal"/>
  </rdf:Description>

  <ns0:Dessert rdf:about="http://www.gastronomie.fr/ontology#KouignAmann">
    <schema:name>Kouign Amann</schema:name>
    <ns0:estOriginaireDe rdf:resource="http://www.gastronomie.fr/ontology#Bretagne"/>
    <ns0:aPourRecette>
      <ns0:Recette rdf:about="http://www.gastronomie.fr/ontology#RecetteKouignAmann">
        <ns0:aMethodeDePreparation>Pâte levée feuilletée, alternance de couches de beurre et de sucre</ns0:aMethodeDePreparation>
        <ns0:aTempsDePreparation rdf:datatype="http://www.w3.org/2001/XMLSchema#duration">PT1H30M</ns0:aTempsDePreparation>
        <ns0:sePrepareAvec>farine</ns0:sePrepareAvec>
        <ns0:sePrepareAvec>beurre salé</ns0:sePrepareAvec>
        <ns0:sePrepareAvec>sucre</ns0:sePrepareAvec>
        <ns0:sePrepareAvec>levure</ns0:sePrepareAvec>
        <ns0:aDifficulte>difficile</ns0:aDifficulte>
      </ns0:Recette>
    </ns0:aPourRecette>

    <ns0:aTypeDeRegime rdf:resource="http://www.gastronomie.fr/ontology#Normal"/>
    <ns0:aTypeDeRegime rdf:resource="http://www.gastronomie.fr/ontology#Vegetarien"/>
  </ns0:Dessert>

  <rdf:Description rdf:about="http://www.gastronomie.fr/ontology#CentreValLoire">
    <rdf:type rdf:resource="http://data.ign.fr/def/geofla#Region"/>
    <rdfs:label xml:lang="fr">Centre-Val de Loire</rdfs:label>
    <owl:sameAs rdf:resource="http://dbpedia.org/ontology/Centre_Val_de_Loire"/>
  </rdf:Description>

  <ns0:Dessert rdf:about="http://www.gastronomie.fr/ontology#TarteTatin">
    <schema:name>Tarte Tatin</schema:name>
    <ns0:estOriginaireDe rdf:resource="http://www.gastronomie.fr/ontology#CentreValLoire"/>
    <ns0:aPourRecette>
      <ns0:Recette rdf:about="http://www.gastronomie.fr/ontology#RecetteTarteTatin">
        <ns0:aMethodeDePreparation>pomme epuchées au caramel placés dans une lit de pâte feuilletée</ns0:aMethodeDePreparation>
        <ns0:aTempsDePreparation rdf:datatype="http://www.w3.org/2001/XMLSchema#duration">PT1H30M</ns0:aTempsDePreparation>
        <ns0:aDifficulte>facile</ns0:aDifficulte>
        <ns0:sePrepareAvec>pommes</ns0:sePrepareAvec>
        <ns0:sePrepareAvec>sucre</ns0:sePrepareAvec>
        <ns0:sePrepareAvec>beurre</ns0:sePrepareAvec>
        <ns0:sePrepareAvec>pâte feuilletée</ns0:sePrepareAvec>
        <ns0:sePrepareAvec>cannelle</ns0:sePrepareAvec>
      </ns0:Recette>
    </ns0:aPourRecette>

    <ns0:aTypeDeRegime rdf:resource="http://www.gastronomie.fr/ontology#Vegetarien"/>
  </ns0:Dessert>

  <rdf:Description rdf:about="http://www.gastronomie.fr/ontology#Normandie">
