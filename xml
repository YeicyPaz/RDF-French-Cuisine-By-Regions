  <rdfs:Class rdf:about="http://www.gastronomie.fr/ontology#Recette">
    <owl:equivalentClass rdf:resource="http://schema.org/Recipe"/>
  </rdfs:Class>

  <rdfs:Class rdf:about="http://www.gastronomie.fr/ontology#SpecialiteCulinaire">
    <owl:equivalentClass rdf:resource="http://dbpedia.org/ontology/Food"/>
  </rdfs:Class>

  <rdfs:Class rdf:about="http://www.gastronomie.fr/ontology#ProduitDuTerroir">
    <rdfs:subClassOf rdf:resource="http://www.gastronomie.fr/ontology#SpecialiteCulinaire"/>
  </rdfs:Class>

  <rdfs:Class rdf:about="http://www.gastronomie.fr/ontology#Plat">
    <rdfs:subClassOf rdf:resource="http://www.gastronomie.fr/ontology#SpecialiteCulinaire"/>
  </rdfs:Class>

  <rdfs:Class rdf:about="http://www.gastronomie.fr/ontology#Dessert">
