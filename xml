        <ns0:aMethodeDePreparation>Une marinade au vin</ns0:aMethodeDePreparation>
        <ns0:aDifficulte>facile</ns0:aDifficulte>
      </ns0:Recette>
    </ns0:aPourRecette>

    <ns0:estOriginaireDe rdf:resource="http://www.gastronomie.fr/ontology#BourgogneFrancheCompte"/>
  </ns0:Plat>

