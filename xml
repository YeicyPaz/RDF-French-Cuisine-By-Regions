  <ns0:Plat rdf:about="http://www.gastronomie.fr/ontology#BoeufBourguignon">
    <schema:name>Bœuf Bourguignon</schema:name>
    <ns0:aTypeDeRegime rdf:resource="http://www.gastronomie.fr/ontology#Normal"/>
    <ns0:aPourRecette>
      <ns0:Recette rdf:about="http://www.gastronomie.fr/ontology#RecetteBoeufBourguignon">
        <ns0:aTempsDePreparation rdf:datatype="http://www.w3.org/2001/XMLSchema#duration">PT4H</ns0:aTempsDePreparation>
        <ns0:sePrepareAvec>bœuf</ns0:sePrepareAvec>
