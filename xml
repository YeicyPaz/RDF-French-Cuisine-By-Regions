  <ns0:Plat rdf:about="http://www.gastronomie.fr/ontology#MoulesDesBouchot">
    <schema:name>Moules des Bouchot</schema:name>
    <ns0:estOriginaireDe rdf:resource="http://www.gastronomie.fr/ontology#HautesDeFrance"/>
    <ns0:aPourRecette>
      <ns0:Recette rdf:about="http://www.gastronomie.fr/ontology#RecetteMoulesDesBouchot">
        <ns0:aDifficulte>moyenne</ns0:aDifficulte>
        <ns0:sePrepareAvec>moules</ns0:sePrepareAvec>
        <ns0:sePrepareAvec>citron</ns0:sePrepareAvec>
        <ns0:sePrepareAvec>eau</ns0:sePrepareAvec>
        <ns0:sePrepareAvec>beurre</ns0:sePrepareAvec>
        <ns0:aTempsDePreparation rdf:datatype="http://www.w3.org/2001/XMLSchema#duration">PT40M</ns0:aTempsDePreparation>
        <ns0:aMethodeDePreparation>Nettoyer les moules et le faire boullir pendant 20 minutes, à la fin ajouter de beurre fondue et du citron</ns0:aMethodeDePreparation>
      </ns0:Recette>
    </ns0:aPourRecette>

    <ns0:aTypeDeRegime rdf:resource="http://www.gastronomie.fr/ontology#Normal"/>
  </ns0:Plat>

