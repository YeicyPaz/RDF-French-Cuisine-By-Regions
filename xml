  <owl:ObjectProperty rdf:about="http://www.gastronomie.fr/ontology#estOriginaireDe">
    <rdfs:subPropertyOf rdf:resource="http://dbpedia.org/ontology/origin"/>
    <rdfs:domain rdf:resource="http://www.gastronomie.fr/ontology#SpecialiteCulinaire"/>
    <rdfs:range rdf:resource="http://data.ign.fr/def/geofla#Region"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.gastronomie.fr/ontology#aPourRecette">
    <owl:equivalentProperty rdf:resource="http://schema.org/recipe"/>
    <rdfs:domain>
      <owl:Class>
        <owl:unionOf>
          <rdf:Description>
            <rdf:first rdf:resource="http://www.gastronomie.fr/ontology#Dessert"/>
            <rdf:rest>
              <rdf:Description>
                <rdf:first rdf:resource="http://www.gastronomie.fr/ontology#Plat"/>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
              </rdf:Description>
            </rdf:rest>

          </rdf:Description>
        </owl:unionOf>

      </owl:Class>
    </rdfs:domain>

    <rdfs:range rdf:resource="http://www.gastronomie.fr/ontology#Recette"/>
  </owl:ObjectProperty>

  <owl:DatatypeProperty rdf:about="http://www.gastronomie.fr/ontology#aDifficulte">
    <rdfs:domain rdf:resource="http://www.gastronomie.fr/ontology#Recette"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:ObjectProperty rdf:about="http://www.gastronomie.fr/ontology#sePrepareAvec">
    <rdfs:subPropertyOf rdf:resource="http://schema.org/recipeIngredient"/>
    <rdfs:domain rdf:resource="http://www.gastronomie.fr/ontology#Recette"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:ObjectProperty>

  <owl:DatatypeProperty rdf:about="http://www.gastronomie.fr/ontology#aTempsDePreparation">
    <rdfs:subPropertyOf rdf:resource="http://schema.org/prepTime"/>
    <rdfs:domain rdf:resource="http://www.gastronomie.fr/ontology#Recette"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:ObjectProperty rdf:about="http://www.gastronomie.fr/ontology#aTypeDeRegime">
    <owl:equivalentProperty rdf:resource="http://schema.org/suitableForDiet"/>
    <rdfs:domain rdf:resource="http://www.gastronomie.fr/ontology#Recette"/>
    <rdfs:domain rdf:resource="http://www.gastronomie.fr/ontology#ProduitDuTerroir"/>
    <rdfs:range rdf:resource="http://www.gastronomie.fr/ontology#typeDeRegime"/>
  </owl:ObjectProperty>

  <owl:DatatypeProperty rdf:about="http://www.gastronomie.fr/ontology#aMethodeDePreparation">
    <rdfs:subPropertyOf rdf:resource="http://schema.org/recipeInstructions"/>
    <rdfs:domain rdf:resource="http://www.gastronomie.fr/ontology#Recette"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:ObjectProperty rdf:about="http://www.gastronomie.fr/ontology#faitAvec">
    <rdfs:subPropertyOf rdf:resource="http://schema.org/recipeIngredient"/>
  </owl:ObjectProperty>

